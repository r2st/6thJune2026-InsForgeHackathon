# Hush — environment template
#
# Copy this file to `.env` and fill in values. `.env` is gitignored.
#   cp .env.example .env
#
# Each section maps to a service in docs/deployment.md.
# Pull values from the sources noted in the §2 "Secrets we will need" table.
# -----------------------------------------------------------------------------


# ───────────── InsForge (backend) ─────────────
# InsForge dashboard → Project Settings → Project ID
INSFORGE_PROJECT_ID=

# InsForge dashboard → Project Settings → API Keys → anon (public)
# Safe to expose in client bundles (RLS enforces access).
INSFORGE_ANON_KEY=

# InsForge dashboard → Project Settings → API Keys → service_role
# SERVER-SIDE ONLY. Bypasses RLS. Never expose in a Next.js NEXT_PUBLIC_* var.
INSFORGE_SERVICE_KEY=

# Created in deployment.md §4:
#   insforge branch create hush-fix-sandbox --from prod
#   insforge branch list
INSFORGE_BRANCH_PROJECT_ID=


# ───────────── AI providers ─────────────
# Embeddings go through OpenRouter (the InsForge AI gateway), used by
# functions/ingest.ts.
OPENROUTER_API_KEY=
# Diagnosis (functions/diagnose.ts) calls Claude directly via the Anthropic SDK.
# Get a key at console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=


# ───────────── Memoir (learn-from-rejections memory · ticket 0043) ─────────────
# Versioned memory of past fix outcomes; recalled at score time so a prior
# merged/rejected neighbour shapes confidence (functions/memory.ts). Optional —
# unset falls back to the neutral pgvector signal (50), pipeline never blocks.
#
# Sponsor confirmed: memoir-ai.dev (zhangfengcdt/memoir). It is a LOCAL tool —
# there is NO Memoir token. Install: `pipx install memoir-ai`. Create a store
# once: `memoir new <path>`. Point at it with MEMOIR_STORE below. Semantic
# recall/classification reuses ANTHROPIC_API_KEY (above); without credit it
# falls back to keyword recall, which still returns neighbours.
MEMOIR_STORE=


# ───────────── Replicas (session capture · ticket 0041) ─────────────
# Production "Watch" source. When set AND a real Replicas SDK adapter is wired
# into apps/demo (resolveCaptureSource), capture comes from Replicas and the
# run is tagged captureSource:'replicas'. Unset ⇒ capture falls back to rrweb
# (captureSource:'rrweb') with zero network dependency — the demo always runs.
# NOTE: the Replicas SDK adapter is not wired yet; confirm the API per ticket
# 0041 before relying on it. Both server (secret) and client (NEXT_PUBLIC) forms
# below — use whichever their SDK needs.
REPLICAS_API_KEY=
NEXT_PUBLIC_REPLICAS_API_KEY=


# ───────────── Lim.run (fork visual re-verify · ticket 0042) ─────────────
# After the policy replay proves the fix on the fork, Lim.run boots a cloud
# browser on the forked app and produces a shareable live-preview URL embedded
# in the receipt + PR ("open the fix, live"). CORROBORATION ONLY — never gates
# the verdict. Unset ⇒ reverifyOnFork() returns { rendered:false, previewUrl:null }
# and the pipeline is unchanged. NOTE: the Lim.run SDK adapter is not wired yet;
# confirm the API at https://docs.limrun.com/docs before relying on it.
LIMRUN_API_KEY=


# ───────────── Devin (fix agent) ─────────────
# Devin workspace → Settings → API
DEVIN_API_KEY=

# The repo Hush will open PRs against — separate from this hackathon repo.
# Format: owner/repo
# GitHub Actions syncs this into InsForge as runtime secret GITHUB_REPO.
DEVIN_TARGET_REPO=


# ───────────── GitHub (PR loop) ─────────────
# Fine-grained PAT scoped to DEVIN_TARGET_REPO with:
#   contents: read+write
#   pull-requests: read+write
#   issues: read+write
# Do NOT reuse `gh auth token` — mint a fresh one bound to this workflow.
GITHUB_TOKEN=


# ───────────── Vercel (CI deploys only) ─────────────
# Vercel → Account Settings → Tokens. Required only for CI; local `vercel` CLI
# handles auth interactively.
VERCEL_TOKEN=

# Vercel → Project Settings → General. Required by GitHub Actions because the
# repo does not commit `.vercel/project.json`.
VERCEL_ORG_ID=
VERCEL_DEMO_PROJECT_ID=
VERCEL_RECEIPT_PROJECT_ID=


# ───────────── Public (NEXT_PUBLIC_*) — safe in client bundles ─────────────
# URL of the deployed `ingest` edge function. Filled after deployment.md §5.
NEXT_PUBLIC_INGEST_URL=

# URL of the receipt page. Filled after deployment.md §7. The demo storefront
# links to this so judges can follow along.
NEXT_PUBLIC_RECEIPT_URL=


# ───────────── Local dev (optional) ─────────────
# Set to 1 to skip the Devin call and stub a PR locally during edge-fn dev.
HUSH_STUB_DEVIN=0
